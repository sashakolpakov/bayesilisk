{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bayesilisk.local/schemas/attention-plane.schema.json",
  "title": "Bayesilisk attention plane",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attentionScore",
    "decayForFixedOrMuted",
    "embeddingSimilarity",
    "failureCount",
    "failureDensity",
    "invariantId",
    "keywordHits",
    "playwrightEvidence",
    "priorAdjustment",
    "reasons",
    "sensitivity",
    "testedCount",
    "untestedness"
  ],
  "properties": {
    "attentionScore": {"type": "number", "minimum": 0, "maximum": 1},
    "decayForFixedOrMuted": {"type": "number", "minimum": 0},
    "embeddingSimilarity": {"type": "number", "minimum": 0, "maximum": 1},
    "failureCount": {"type": "integer", "minimum": 0},
    "failureDensity": {"type": "number", "minimum": 0, "maximum": 1},
    "invariantId": {"type": "string"},
    "keywordHits": {"type": "integer", "minimum": 0},
    "playwrightEvidence": {"type": "number", "minimum": 0, "maximum": 1},
    "priorAdjustment": {"type": "number"},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "sensitivity": {"type": "number", "minimum": 0, "maximum": 1},
    "testedCount": {"type": "integer", "minimum": 0},
    "untestedness": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
