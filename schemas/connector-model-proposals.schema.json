{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bayesilisk.local/schemas/connector-model-proposals.schema.json",
  "title": "Compact connector ABAG model response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenarios"
  ],
  "properties": {
    "scenarios": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "sequenceRuleId",
          "sequenceSteps"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "sequenceRuleId": {
            "type": "string",
            "minLength": 1
          },
          "sequenceSteps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "connectorAction"
                  ],
                  "properties": {
                    "connectorAction": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "reuseProposalId"
                  ],
                  "properties": {
                    "reuseProposalId": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
