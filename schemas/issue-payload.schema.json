{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bayesilisk.local/schemas/issue-payload.schema.json",
  "title": "Bayesilisk issue payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attentionReasons",
    "attentionScore",
    "body",
    "classification",
    "dedupeKey",
    "dedupeState",
    "fingerprint",
    "invariantId",
    "issuePayloadSource",
    "issueReadiness",
    "labels",
    "modelProvenance",
    "posteriorMode",
    "riskScore",
    "scenarioId",
    "title"
  ],
  "properties": {
    "attentionReasons": {"type": "array", "items": {"type": "string"}},
    "attentionScore": {"type": "number", "minimum": 0, "maximum": 1},
    "body": {"type": "string"},
    "classification": {"type": "string"},
    "dedupeKey": {"type": "string", "pattern": "^bayesilisk:[0-9a-f]{16}:"},
    "dedupeState": {"type": "string", "enum": ["existing-fingerprint", "existing-title", "new"]},
    "fingerprint": {"type": "string", "pattern": "^bayesilisk:[0-9a-f]{16}$"},
    "invariantId": {"type": "string"},
    "issuePayloadSource": {"type": "string", "const": "verifiedByBayesilisk"},
    "issueReadiness": {"type": "string", "const": "ready-for-issue"},
    "labels": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "modelProvenance": {"type": ["object", "null"]},
    "minimizedReproducer": {"type": ["object", "null"]},
    "originalScenario": {"type": ["object", "null"]},
    "posteriorMode": {"type": "string"},
    "riskScore": {"type": "number", "minimum": 0, "maximum": 1},
    "scenarioId": {"type": "string"},
    "title": {"type": "string"}
  }
}
