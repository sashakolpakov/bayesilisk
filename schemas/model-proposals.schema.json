{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bayesilisk.local/schemas/model-proposals.schema.json",
  "title": "Bayesilisk weak model scenario proposals",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenarios"],
  "properties": {
    "scenarios": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fragments", "invariants", "targetPlane", "title"],
        "properties": {
          "fragments": {"type": "array", "minItems": 2, "maxItems": 12, "items": {"type": "string"}},
          "invariants": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string"}},
          "targetPlane": {"type": "string"},
          "title": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
